# Copy to .env and fill in values:
#   cp .env.example .env
# Never commit .env
#
# Local:       docker compose -f docker-compose.dev.yml up --build
# Production:  bash scripts/deploy-production.sh   (or scripts\deploy-production.bat)

# --- Required secrets ---
# python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me-generate-a-long-random-secret
DB_PASSWORD=change-me-strong-db-password
# Required for production compose; optional for local (leave empty)
REDIS_PASSWORD=change-me-strong-redis-password

# --- Local defaults (docker-compose.dev.yml) ---
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,backend
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FORCE_HTTPS=False
FRONTEND_PORT=3000
BACKEND_PORT=8000
DOMAIN=localhost
ENABLE_API_DOCS=True

# --- Production (docker-compose.yml) — uncomment / replace before deploy ---
# DEBUG=False
# FORCE_HTTPS=True
# DOMAIN=yourdomain.com
# ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com,backend
# FRONTEND_URL=https://yourdomain.com
# NEXT_PUBLIC_API_URL=https://yourdomain.com/api
# NEXT_PUBLIC_WS_URL=wss://yourdomain.com/ws
# CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
# CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
# CERTBOT_EMAIL=admin@yourdomain.com
# ENABLE_API_DOCS=False
# After first admin create, remove DJANGO_SUPERUSER_PASSWORD from .env

# Database
DB_NAME=aidesign
DB_USER=postgres

# Bootstrap (optional — remove password from .env after first boot)
INIT_SUBSCRIPTION_TIERS=True
CELERY_CONCURRENCY=2
# DJANGO_SUPERUSER_EMAIL=admin@yourdomain.com
# DJANGO_SUPERUSER_USERNAME=admin
# DJANGO_SUPERUSER_PASSWORD=

# AI — at least one key required for generation
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/llama-3.1-70b-instruct
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-1.5-pro
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4-turbo-preview
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Email (production uses SMTP by default; local uses console)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@yourdomain.com

# Optional
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SENTRY_DSN=

# Backups (scripts/backup.py via docker compose exec)
BACKUP_DIR=/app/backups
# USE_S3_BACKUP=False
# S3_BACKUP_BUCKET=
